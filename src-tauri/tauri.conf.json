{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "artdaddy",
  "version": "0.15.0",
  "identifier": "com.artdaddy.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ArtDaddy",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/ArtDaddy", "$DATA/ArtDaddy/**", "$LOCALDATA/Packages/**", "$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/artdaddy-ffmpeg",
      "binaries/artdaddy-ffprobe",
      "binaries/artdaddy-yt-dlp",
      "binaries/artdaddy-whisper-cli",
      "binaries/artdaddy-browser"
    ],
    "resources": [
      "resources/artdaddy-browser.mjs",
      "resources/artdaddy.mcpb",
      "resources/ms-playwright/**/*",
      "resources/node_modules/**/*",
      "resources/fonts/*",
      "resources/brand/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://artdaddy.app/updates/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCMkZDNTVFNzU5RjVGOTIKUldTU1g1OTFYc1V2bXdMMG1yNDdzNkZWU1dvbnkxbFVNRENWZGlGREowd0pUTVhrdThReU5BWHcK",
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["artdaddy"]
      }
    }
  }
}
