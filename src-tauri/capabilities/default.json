{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/ffmpeg", "sidecar": true, "args": true },
        { "name": "binaries/ffprobe", "sidecar": true, "args": true },
        { "name": "binaries/yt-dlp", "sidecar": true, "args": true },
        { "name": "binaries/whisper-cli", "sidecar": true, "args": true },
        { "name": "binaries/artdaddy-browser", "sidecar": true, "args": true }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "binaries/ffmpeg", "sidecar": true, "args": true },
        { "name": "binaries/ffprobe", "sidecar": true, "args": true },
        { "name": "binaries/yt-dlp", "sidecar": true, "args": true },
        { "name": "binaries/whisper-cli", "sidecar": true, "args": true },
        { "name": "binaries/artdaddy-browser", "sidecar": true, "args": true }
      ]
    },
    "shell:allow-kill",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DATA/ArtDaddy" },
        { "path": "$DATA/ArtDaddy/**" },
        { "path": "$LOCALDATA/Packages/**" },
        { "path": "$DOWNLOAD" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$HOME" },
        { "path": "$HOME/**" }
      ]
    },
    "dialog:default",
    "deep-link:default"
  ]
}
