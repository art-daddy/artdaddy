{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Enables the default permissions. The fs scope is deliberately whole-disk: a video editor's footage lives on the big second drive, the folder picker already lets anyone choose one, and refusing it afterwards meant the UI promised what the sandbox denied - a project on D:\\ failed every file read with 'forbidden path' as an unhandled rejection carrying no message, so the app just never opened it. The agent still reaches media only through media_ref and the library (isUnsafeAgentRef), so the injection surface is unchanged; what this gives up is containment of a bug in any direct fs call.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/artdaddy-ffmpeg", "sidecar": true, "args": true },
        { "name": "binaries/artdaddy-ffprobe", "sidecar": true, "args": true },
        { "name": "binaries/artdaddy-yt-dlp", "sidecar": true, "args": true },
        { "name": "binaries/artdaddy-whisper-cli", "sidecar": true, "args": true },
        { "name": "binaries/artdaddy-browser", "sidecar": true, "args": true }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "binaries/artdaddy-ffmpeg", "sidecar": true, "args": true },
        { "name": "binaries/artdaddy-ffprobe", "sidecar": true, "args": true },
        { "name": "binaries/artdaddy-yt-dlp", "sidecar": true, "args": true },
        { "name": "binaries/artdaddy-whisper-cli", "sidecar": true, "args": true },
        { "name": "binaries/artdaddy-browser", "sidecar": true, "args": true }
      ]
    },
    "shell:allow-kill",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DATA/ArtDaddy" },
        { "path": "$DATA/ArtDaddy/**" },
        { "path": "$LOCALDATA/Packages/**" },
        { "path": "$DOWNLOAD" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$HOME" },
        { "path": "$HOME/**" },
        { "path": "*" },
        { "path": "**" },
        { "path": "/**" }
      ]
    },
    "dialog:default",
    "deep-link:default"
  ]
}
