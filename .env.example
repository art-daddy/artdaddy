# API base URL of the ArtDaddy FastAPI server. Copy to .env to override.
# A BUILD bakes this value straight into the bundle, so leave it pointing at a real server.
#
# Dev-only overrides belong in .env.development, which `vite serve` loads and `vite build`
# ignores — so a dev value can never reach a shipped bundle. To develop against the DEPLOYED
# server, put this in .env.development (http://localhost:5173 is not on that server's CORS
# allowlist, so calling it directly fails as "Failed to fetch" and sign-in cannot complete):
#   VITE_API_BASE_URL=http://localhost:5173/api
#   ARTDADDY_DEV_API_TARGET=https://<deployed-server>
# ARTDADDY_DEV_API_TARGET registers the proxy in vite.config.ts; unset, no proxy is added.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Sentry DSN for client error reporting (optional; unset = no reporting).
VITE_SENTRY_DSN=

# Lets the desktop/UI e2e lanes past the sign-in gate on a machine with no keychain session.
# Inlined at BUILD time; vite.config.ts REFUSES a production build with it set, so build the
# e2e app with `--mode e2e`. Never set this for a release.
# VITE_E2E_AUTH_BYPASS=1

# No Clerk key here: the app never runs Clerk. Sign-in happens in the system browser at
# artdaddy.app/auth (auth-broker/index.html), which carries the publishable key itself.
