eslint-out.txt
npm-install.err

# Local run reports (bench/eval/mutation are regenerated by their lanes)
reports/

# Intermediate rasters from `npm run brand:assets`. The three colourways beside them ARE
# the assets and are tracked; these are just the uncoloured step on the way.
brand/*-1024.png

# The demo reel is proof, not an asset, and it is megabytes.
# Regenerate with `npm run brand:video -- --demo`.
brand/video/demo-*.mp4

# `tauri icon` also emits mobile sets. Nothing here builds for mobile, and they are
# regenerated on every run, so they are noise in a diff rather than source.
src-tauri/icons/android/
src-tauri/icons/ios/

# Release staging: installers/dmgs pulled down to publish. Hundreds of MB, and the
# published copy in blob storage is the one that matters.
_rel/

# Playwright failure artifacts (traces/screenshots) from the e2e:ui lane
test-results/

# â”€â”€ Internal / not-for-publication â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# These are excluded from the PUBLIC repository. They are product-management and
# marketing material, or candid engineering notes, none of which the app needs to
# build or test. They live in a separate private repo; see the private README.
#
# NOTE: adding a path here does NOT untrack a file that is already committed. These
# rules take effect when the public repo is created fresh (git init + git add .).

# Product/strategy notes and internal reviews
ideas.md
todos.md
issues.md
openmontage_ideas.md
docs/BENCH_FRICTION_TRIAGE.md
docs/BENCH_TOOL_FRICTION.md
docs/LAUNCH_FILM_PLAYBOOK.md
docs/DISTRIBUTION_PLAYBOOK.md
docs/MARKET_RESEARCH.md
docs/research/
_research/

# Candid engineering postmortems written for the coding agent, not for users
.github/copilot-instructions.md
AGENTS.md
CLAUDE.md
.cursor/

# Marketing site + its video assets (own repo; ~54 MB of reels)
landing/

# Ad-hoc preview probes used while chasing rendering bugs
preview-probe*.html
preview-parity.html

# Scratch output from local runs
_*.txt
_*.err
pytest_out.txt
reports/
skills/

# Framed end-to-end as parity with a competitor's editor; internal engineering notes.
docs/MANUAL_EDITING_PARITY.md

# Vite writes these while resolving a TS config; regenerated on every dev run.
vite.config.ts.timestamp-*
docs/DEVELOPMENT.md
# `_*.txt` above is for root-level scratch, but it is unanchored, so it also swallowed this
# render fixture -- which the export golden test reads and cannot regenerate for itself. It was
# tracked here for years and only vanished when a fresh repo re-applied the ignore rules.
!src/timeline/__golden.export.txt
