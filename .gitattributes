# Shown in the Windows installer's text box, which reads the file in the system codepage
# with Windows line endings. Pinned so the runner's git config cannot change what ships.
src-tauri/PRIVACY.txt text eol=crlf
*.snap text eol=lf
src/timeline/__golden.export.txt text eol=lf
# Git hooks run under sh, where a CR at the end of a line breaks a strict shell.
.githooks/* text eol=lf
# Project folders written by older releases (src/tools/project.goldens.test.ts): kept byte for byte as
# those releases wrote them, on every platform.
src/tools/__fixtures__/goldenProjects/** -text
# The update feed exactly as it is served: tests compare its bytes, so git must not change its line endings.
src-tauri/tests/fixtures/updater/*.json -text
