{
  "name": "artdaddy-client",
  "private": true,
  "version": "0.13.1",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "ArtDaddy editor client (web-first React app; Tauri desktop shell wraps the same bundle later). Talks to the ArtDaddy FastAPI server over REST + SSE + WS.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "codegen": "node scripts/codegen.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "test:audio": "node --experimental-websocket scripts/audiolane/run.mjs",
    "e2e:ui": "playwright test",
    "e2e:desktop": "wdio run e2e/desktop/wdio.conf.mjs",
    "e2e:drag": "node e2e/desktop/drag.desktop.mjs",
    "e2e:osdrop": "node e2e/desktop/osdrop.desktop.mjs",
    "e2e:mcp": "node e2e/desktop/mcp.desktop.mjs",
    "e2e:mcp-behaviour": "node e2e/desktop/mcpBehaviour.desktop.mjs",
    "e2e:mcp-alltools": "node e2e/desktop/mcpAllTools.desktop.mjs",
    "test:all": "vitest run && vitest run --config vitest.smoke.config.ts",
    "mutation": "stryker run",
    "eval": "vitest run --config vitest.eval.config.ts",
    "eval:mini": "vitest run --config vitest.eval.mini.config.ts",
    "mine": "vitest run --config vitest.mine.config.ts",
    "setup:sidecars": "node scripts/setup-sidecars.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "brand:assets": "node scripts/brand-assets.mjs",
    "brand:video": "node scripts/brand-video.mjs",
    "landing:deploy": "node scripts/landing-deploy.mjs",
    "auth-broker:deploy": "node scripts/auth-broker-deploy.mjs",
    "fetch:sidecars": "node scripts/fetch-sidecars.mjs",
    "bundle:browser": "node scripts/bundle-browser.mjs",
    "release": "npm run fetch:sidecars && npm run build:sidecar && npm run build:mcpb && npm run bundle:browser && tauri build",
    "release:verify": "node scripts/verify-release-signature.mjs"
  },
  "dependencies": {
    "@sentry/react": "^10.66.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "fflate": "^0.8.3",
    "mp4box": "^0.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.21.5",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.10.6",
    "jsdom": "^27.0.1",
    "openapi-typescript": "^7.4.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^3.2.6"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "4.62.2",
    "@rollup/rollup-darwin-x64": "4.62.2",
    "@rollup/rollup-linux-x64-gnu": "4.62.2",
    "@rollup/rollup-win32-x64-msvc": "4.62.2"
  }
}
